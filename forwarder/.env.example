# Names only — do not commit real values. Copy to .env.local for local use.
# Set these in Vercel → Project → Settings → Environment Variables.

# Cursor agent inbound webhook (required for forward)
CURSOR_WEBHOOK_URL=
CURSOR_WEBHOOK_KEY=

# Comma-separated emails allowed to trigger forward (deny-all when empty)
# Accepts bare emails or "Name <email>" forms; matched case-insensitively.
ALLOWLIST=you@example.com,operator@example.com

# AgentMail / Svix webhook signing secret (REQUIRED for production)
# Format: whsec_... (base64 key material after prefix)
# From AgentMail webhook create response / dashboard (webhook.secret)
AGENTMAIL_WEBHOOK_SECRET=whsec_...

# Set to 1 to enforce signature verification (recommended when secret is set)
REQUIRE_AGENTMAIL_SIGNATURE=1

# Optional: Restrict to a specific AgentMail inbox ID for defense-in-depth
# When set with AGENTMAIL_WEBHOOK_SECRET, only webhooks matching this inbox ID are accepted
# AGENTMAIL_INBOX_ID=

# Dev only: allow unsigned webhooks when AGENTMAIL_WEBHOOK_SECRET is unset.
# Ignored when AGENTMAIL_WEBHOOK_SECRET is set; REQUIRE_AGENTMAIL_SIGNATURE takes precedence.
# ALLOW_UNSIGNED_WEBHOOKS=1
